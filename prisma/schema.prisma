datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id              String  @id
  name            String
  email           String  @unique
  phone           String
  passwordHash    String
  role            String
  createdAt       String
  partnerType     String?
  status          String?
  starRating      String?
  documents       String? // Saved as serialized JSON string
  rejectionReason String?

  // --- SAVER Fleet Ops (Partie A) : RBAC, sites, profils ---
  roleId             String?
  rolePrincipal      Role?          @relation("RolePrincipal", fields: [roleId], references: [id])
  secondaryRoleId    String?
  roleSecondaire     Role?          @relation("RoleSecondaire", fields: [secondaryRoleId], references: [id])
  active             Boolean        @default(true) // soft delete : false = compte désactivé
  clientId           String? // contact rattaché à un Client externe (accès flotte)
  client             Client?        @relation(fields: [clientId], references: [id])
  sites              UserSite[]
  driverProfile      DriverProfile?
  auditLogs          AuditLog[]     @relation("AuditActor")
  settingsCreated    SiteSettings[] @relation("SettingsCreatedBy")
  driverAssignments  Assignment[]   @relation("DriverAssignments")
  createdAssignments Assignment[]   @relation("CreatedAssignments")
}

// =============================================================================
// SAVER Fleet Ops — Partie A (Bloc 1 : Profils & RBAC)
// =============================================================================

// --- Organisation : sites (villes) et zones géographiques ---
model Site {
  id             String          @id @default(cuid())
  nom            String
  ville          String
  timezone       String          @default("Africa/Abidjan")
  waveAccountId  String? // identifiant du compte Wave dédié (jamais de secret en clair)
  active         Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  zones          Zone[]
  users          UserSite[]
  settings       SiteSettings[]
  driverProfiles DriverProfile[]
  fleetVehicles  FleetVehicle[]
  devicePhones   DevicePhone[]
  assignments    Assignment[]
}

model Zone {
  id        String          @id @default(cuid())
  siteId    String
  site      Site            @relation(fields: [siteId], references: [id], onDelete: Cascade)
  nom       String
  createdAt DateTime        @default(now())
  drivers   DriverProfile[]

  @@unique([siteId, nom])
}

// --- RBAC : permissions granulaires, rôles, associations modifiables ---
model Permission {
  id        String           @id @default(cuid())
  code      String           @unique // ex. "vehicule.creer", "avance.autoriser"
  libelle   String
  categorie String // regroupement pour l'écran d'admin (ex. "Véhicules")
  roles     RolePermission[]
}

model Role {
  id              String           @id @default(cuid())
  code            String           @unique // ex. "admin_direction", "dispatcher"
  nom             String
  description     String?
  isSystem        Boolean          @default(false) // rôle protégé (non supprimable)
  active          Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  permissions     RolePermission[]
  usersPrincipal  User[]           @relation("RolePrincipal")
  usersSecondaire User[]           @relation("RoleSecondaire")
}

model RolePermission {
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

// --- Rattachement multi-sites d'un utilisateur ---
model UserSite {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
}

// --- Profil chauffeur (champs nécessaires dès la Partie A pour les flux B/C/D) ---
model DriverProfile {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  siteId           String?
  site             Site?     @relation(fields: [siteId], references: [id])
  zoneId           String?
  zone             Zone?     @relation(fields: [zoneId], references: [id])
  permisNumero     String?
  permisExpiration DateTime? // utilisée plus tard pour bloquer le check-in (Flux 1)
  dateEntree       DateTime? // ancienneté (éligibilité avance, Flux 6)
  statut           String    @default("actif") // actif | suspendu
  socDernierConnu  Int? // dernier SOC connu (%), alimenté au check-out (Flux 1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

// --- Client externe en gestion de flotte (entité + contacts multiples) ---
model Client {
  id            String         @id @default(cuid())
  raisonSociale String
  contactNom    String?
  contactEmail  String?
  contactPhone  String?
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contacts      User[] // utilisateurs externes rattachés (accès flotte)
  fleetVehicles FleetVehicle[]
}

// --- Paramètres globaux par site, versionnés (source de tous les calculs B/C/D) ---
model SiteSettings {
  id            String   @id @default(cuid())
  siteId        String
  site          Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  version       Int
  effectiveFrom DateTime @default(now())
  createdById   String?
  createdBy     User?    @relation("SettingsCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  devise String @default("FCFA")

  // Salaire & éligibilité au fixe
  salaireFixeJour          Int @default(5357)
  eligibiliteCaJour        Int @default(65000)
  eligibiliteCoursesJour   Int @default(40)
  eligibiliteHeures        Int @default(8)
  eligibiliteHeuresEnLigne Int @default(7)

  // KPI & période de paie
  kpiObjectifMontant Int @default(350000)
  kpiSeuilCourses    Int @default(168)
  periodePaieJours   Int @default(14)

  // Bonus (paliers) & plafond
  bonusPaliers Json @default("[{\"minCoursesSupp\":1,\"maxCoursesSupp\":10,\"pct\":10},{\"minCoursesSupp\":11,\"maxCoursesSupp\":19,\"pct\":25},{\"minCoursesSupp\":20,\"maxCoursesSupp\":25,\"pct\":35},{\"minCoursesSupp\":26,\"maxCoursesSupp\":35,\"pct\":50},{\"minCoursesSupp\":36,\"maxCoursesSupp\":null,\"pct\":75}]")
  bonusPlafond Int  @default(25000)

  // Pénalités
  penaliteRetardHeure    Int @default(2000)
  penaliteNonReversement Int @default(5000)
  penaliteAbsence        Int @default(10000)

  // Reversement & avances
  toleranceEcartReversement Int @default(5000)
  avanceEligibiliteJours    Int @default(90)
  avancePlafond             Int @default(50000)

  // Exploitation : SOC, maintenance, préavis d'alertes
  socHandoverSeuil           Int @default(70)
  maintenanceKm              Int @default(15000)
  maintenanceJours           Int @default(90)
  alerteVisiteTechniqueJours Int @default(15)
  alerteAssuranceJours       Int @default(7)

  // Horaires de shift & rythme chauffeur
  shiftADebut                 String @default("06:00")
  shiftAFin                   String @default("14:00")
  shiftBDebut                 String @default("15:00")
  shiftBFin                   String @default("23:00")
  handoverMinutes             Int    @default(30)
  handoverRechargeMinutes     Int    @default(30)
  rythmeJoursTravailles       Int    @default(6)
  rythmeReposDemiJourSemaines Int    @default(2)

  @@unique([siteId, version])
}

// --- Journal d'audit : toute action sensible ---
model AuditLog {
  id           String   @id @default(cuid())
  actorId      String?
  actor        User?    @relation("AuditActor", fields: [actorId], references: [id])
  actorName    String? // dénormalisé (conservé même si le compte est supprimé)
  action       String // ex. "role.permissions.update"
  resourceType String // ex. "Role", "Vehicle", "Assignment"
  resourceId   String?
  siteId       String?
  before       Json?
  after        Json?
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([siteId])
}

model Driver {
  id           String  @id
  userId       String?
  name         String
  phone        String
  email        String
  photo        String?
  availability String?
  status       String
  rating       Float?
  vehicleId    String?
  shift        String?
  createdAt    String?
}

model Vehicle {
  id              String  @id
  category        String
  brand           String
  name            String
  immatriculation String
  batteryLevel    Int
  status          String
  photoFront      String?
  photoBack       String?
  photoLeft       String?
  photoRight      String?
  maxSpeed        Int?
  fuelConsumption String?
  totalDistance   String?
}

model Reservation {
  id                   String   @id
  userId               String
  driverId             String?
  vehicleId            String
  departureDate        String
  departureTime        String
  pickup               String
  destination          String
  formula              String
  totalPrice           Float
  status               String
  segment              String
  options              String? // Saved as serialized JSON array of strings
  createdAt            String
  clientName           String?
  clientPhone          String?
  clientEmail          String?
  specialInstructions  String?
  dispositionConfirmed Boolean? @default(false)
}

model ReservationOption {
  id            String @id
  reservationId String
  optionName    String
  price         Float
}

model Quote {
  id         String @id
  userId     String
  vehicleId  String
  details    String // Saved as serialized JSON string
  adminPrice Float?
  status     String
  createdAt  String
}

model Partner {
  id             String @id
  userId         String
  companyName    String
  commissionRate Float
  contractStart  String
  contractEnd    String
  createdAt      String
}

model Invoice {
  id               String  @id
  partnerId        String?
  corporateId      String?
  month            Int
  year             Int
  totalAmount      Float
  commissionAmount Float
  status           String
  pdfUrl           String
  currency         String?
  createdAt        String
}

model TripLocation {
  id            String @id
  reservationId String
  lat           Float
  lng           Float
  timestamp     String
}

model Shift {
  id                    String   @id
  driverId              String
  driverName            String
  vehicleId             String
  date                  String
  createdAt             String
  startConfirmed        Boolean?
  startTime             String?
  startKm               Int?
  startDepartureTime    String?
  startRechargeChecked  Boolean?
  startInternetChecked  Boolean?
  startPapersChecked    Boolean?
  startDashPhoto        String?
  endConfirmed          Boolean?
  endTime               String?
  endKm                 Int?
  endArrivalTime        String?
  endExteriorPhoto      String?
  endDashPhoto          String?
  endDailyReport        String? // Saved as serialized JSON string
  endRechargeProofPhoto String?
  endPassationConfirmed Boolean?
}

model EcoReport {
  id             String @id
  kmElectrique   Float
  co2NonEmis     Float
  co2EviteTonnes Float
  updatedAt      String
}

// =============================================================================
// SAVER Fleet Ops — Partie A (Bloc 2 : Flux 7 — Enregistrement véhicule)
// =============================================================================

enum VehicleStatus {
  Disponible
  Attribue
  EnCharge
  Immobilise
  EnMaintenance
  HorsFlotte
}

enum ContractType {
  INTERNE_SAVER
  EXTERNE_CLIENT
}

enum ServiceType {
  VTC
  LOCATION_B2B
  B2C
}

enum VehicleDocType {
  CARTE_GRISE
  VISITE_TECHNIQUE
  ASSURANCE
}

enum PhoneStatut {
  ACTIF
  INACTIF
  PERDU
  RECUPERE
}

enum AlertType {
  VISITE_TECHNIQUE
  ASSURANCE
  ENTRETIEN_KM
  ENTRETIEN_DATE
}

enum AlertStatus {
  OUVERTE
  RESOLUE
}

enum NotifCanal {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
}

enum NotifStatus {
  EN_ATTENTE
  ENVOYE
  ECHEC
}

// --- Fichiers uploadés (photos, documents) avec accès contrôlé par RBAC ---
model MediaAsset {
  id           String   @id @default(cuid())
  kind         String // "image" | "pdf" | "autre"
  mime         String
  taille       Int // octets
  chemin       String // chemin relatif dans uploads/
  originalName String?
  resourceType String? // ex. "FleetVehicle" une fois rattaché
  resourceId   String?
  uploadedById String?
  sha256       String? // empreinte du fichier reçu (détecte le renvoi d'une même photo)
  iaLecture    Json? // lecture de l'IA (ex. % batterie du tableau de bord), faite et conservée par le serveur
  createdAt    DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([uploadedById])
  @@index([sha256])
}

// --- Fiche véhicule (Flux 7) ---
model FleetVehicle {
  id                  String        @id @default(cuid())
  immatriculation     String        @unique
  vin                 String        @unique
  marque              String
  modele              String
  siteId              String
  site                Site          @relation(fields: [siteId], references: [id])
  autonomieNominale   Int? // km
  capaciteBatterieKwh Float? // kWh
  statut              VehicleStatus @default(Disponible)

  // Contrat
  contractType         ContractType @default(INTERNE_SAVER)
  clientId             String?
  client               Client?      @relation(fields: [clientId], references: [id])
  dureeContratMois     Int?
  montantRemboursement Int? // FCFA (pour le portail client externe)

  // Service
  serviceType ServiceType @default(VTC)
  classes     Json        @default("[]") // ["Eco","Confort","VIP"]

  // Exploitation
  kmActuel        Int     @default(0)
  socDernierConnu Int? // dernier SOC connu (%)
  gpsBoitierId    String? // boîtier GPS LUOGU (association simple)
  isDraft         Boolean @default(false) // brouillon sauvegardable

  // Maintenance préventive (programmée à l'enregistrement)
  dernierEntretienKm    Int       @default(0)
  dernierEntretienDate  DateTime?
  prochainEntretienKm   Int?
  prochainEntretienDate DateTime?

  // Photos obligatoires (références MediaAsset)
  photoAvant       String?
  photoArriere     String?
  photoGauche      String?
  photoDroite      String?
  photoInterieur   String?
  photoTableauBord String?
  photoEcran       String?
  photoSieges      String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents   VehicleDocument[]
  kmHistory   VehicleKmHistory[]
  phone       DevicePhone?
  assignments Assignment[]

  @@index([siteId])
  @@index([statut])
  @@index([clientId])
}

// --- Documents véhicule : carte grise, visite technique, assurance ---
model VehicleDocument {
  id           String         @id @default(cuid())
  vehicleId    String
  vehicle      FleetVehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  type         VehicleDocType
  numero       String?
  proprietaire String?
  dateDebut    DateTime?
  dateFin      DateTime? // date d'expiration (VT, assurance)
  mediaId      String? // photo du document
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([vehicleId])
}

// --- Téléphone + SIM (matériel propriété SAVER) ---
model DevicePhone {
  id               String        @id @default(cuid())
  siteId           String?
  site             Site?         @relation(fields: [siteId], references: [id])
  imei             String?
  numero           String
  operateur        String?
  statut           PhoneStatut   @default(ACTIF)
  vehicleId        String?       @unique
  vehicle          FleetVehicle? @relation(fields: [vehicleId], references: [id])
  dateAffectation  DateTime?
  dateRecuperation DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

// --- Historique du compteur kilométrique ---
model VehicleKmHistory {
  id        String       @id @default(cuid())
  vehicleId String
  vehicle   FleetVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  km        Int
  source    String       @default("manuel")
  createdAt DateTime     @default(now())

  @@index([vehicleId])
}

// --- Alertes (moteur d'échéances, réutilisable, idempotent via dedupeKey) ---
model Alert {
  id           String      @id @default(cuid())
  type         AlertType
  resourceType String // ex. "FleetVehicle"
  resourceId   String
  siteId       String?
  dueDate      DateTime?
  severity     String      @default("warning") // info | warning | critical
  status       AlertStatus @default(OUVERTE)
  message      String
  dedupeKey    String      @unique // évite les doublons (idempotence)
  createdAt    DateTime    @default(now())
  resolvedAt   DateTime?

  @@index([siteId])
  @@index([status])
}

// --- Notifications (file d'attente + retry, multi-canal) ---
model Notification {
  id        String      @id @default(cuid())
  userId    String?
  canal     NotifCanal
  type      String
  titre     String
  message   String
  payload   Json?
  status    NotifStatus @default(EN_ATTENTE)
  retries   Int         @default(0)
  createdAt DateTime    @default(now())
  sentAt    DateTime?

  @@index([userId])
  @@index([status])
}

// =============================================================================
// SAVER Fleet Ops — Partie A (Bloc 3 : Flux 8 — Attribution quotidienne)
// =============================================================================

enum ShiftCode {
  A
  B
}

enum AssignmentAction {
  CREATION
  REMPLACEMENT
  ANNULATION
}

// --- Attribution courante (état actif) : au plus une par (véhicule, date, shift) ---
model Assignment {
  id          String       @id @default(cuid())
  siteId      String
  site        Site         @relation(fields: [siteId], references: [id])
  date        DateTime // jour de l'attribution (minuit)
  shift       ShiftCode
  driverId    String
  driver      User         @relation("DriverAssignments", fields: [driverId], references: [id])
  vehicleId   String
  vehicle     FleetVehicle @relation(fields: [vehicleId], references: [id])
  lieu        String?
  createdById String?
  createdBy   User?        @relation("CreatedAssignments", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  shiftRecord ShiftRecord?

  // Empêche toute double attribution d'un véhicule sur un même créneau (au niveau BASE).
  @@unique([vehicleId, date, shift])
  @@index([siteId, date])
  @@index([driverId, date])
}

// --- Historique append-only : traçabilité complète (création, remplacement, annulation) ---
model AssignmentEvent {
  id        String           @id @default(cuid())
  siteId    String
  date      DateTime
  shift     ShiftCode
  vehicleId String
  driverId  String
  action    AssignmentAction
  motif     String?
  byUserId  String?
  byName    String?
  createdAt DateTime         @default(now())

  @@index([siteId, date])
  @@index([vehicleId])
  @@index([driverId])
}

// =============================================================================
// SAVER Fleet Ops — Partie B (Bloc B1 : Flux 1 — Check-in / Check-out)
// =============================================================================

enum ShiftRecordStatut {
  EN_ATTENTE
  EN_COURS
  TERMINE
}

// --- Déroulé d'un shift attribué : prise et fin de poste (1-1 avec Assignment) ---
model ShiftRecord {
  id           String            @id @default(cuid())
  assignmentId String            @unique
  assignment   Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  driverId     String
  vehicleId    String
  siteId       String
  date         DateTime
  shift        ShiftCode
  statut       ShiftRecordStatut @default(EN_ATTENTE)

  // Check-in (prise de poste) : 5 preuves
  checkinAt     DateTime?
  gpsLat        Float?
  gpsLng        Float?
  kmDebut       Int?
  photoCompteur String? // mediaId
  photoVehicule String?
  photoPermis   String?
  selfieKyc     String?

  // Check-out (fin de poste) : 4 photos d'état
  checkoutAt   DateTime?
  kmFin        Int?
  photoAvant   String?
  photoArriere String?
  photoGauche  String?
  photoDroite  String?

  // Données d'exploitation calculées au check-out
  kmParcourus  Int?
  dureeMinutes Int?

  alerteRetardEnvoyee Boolean @default(false) // anti-doublon du minuteur 15 min

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  reversement Reversement?

  @@index([siteId, date])
  @@index([driverId, date])
}

// =============================================================================
// SAVER Fleet Ops — Partie B (Bloc B2 : Flux 2 — Reversement des recettes des courses)
// =============================================================================

enum ReversementStatut {
  ACCEPTE // aucun manquant (montant reversé >= attendu)
  ECART_CONSTATE // manquant constaté automatiquement → dette enregistrée
  ECART_A_VALIDER // ancien : écart en attente de double validation (workflow supprimé)
  RAPPROCHE // ancien : double validation effectuée (workflow supprimé)
}

enum DetteStatut {
  EN_COURS
  REMBOURSEE
}

// --- Reversement d'un shift (recettes des courses) : 1-1 avec ShiftRecord ---
model Reversement {
  id            String      @id @default(cuid())
  shiftRecordId String      @unique
  shiftRecord   ShiftRecord @relation(fields: [shiftRecordId], references: [id], onDelete: Cascade)
  driverId      String
  vehicleId     String
  siteId        String
  date          DateTime
  shift         ShiftCode

  // Déclaration du chauffeur
  recette                  Int // recette des courses déclarée
  preuveRecetteMediaId     String? // capture / relevé de recette
  montantReverse           Int // montant effectivement viré (Wave/OM)
  preuveReversementMediaId String? // capture du virement

  // Calculs
  totalDepenses  Int @default(0)
  frais          Int @default(0) // ~1 % (frais Wave estimés)
  montantAttendu Int // recette - dépenses - frais
  ecart          Int // montantAttendu - montantReverse (positif = manquant)

  statut ReversementStatut @default(ACCEPTE)

  // Double validation (Finance + Responsable terrain)
  valideFinanceById String?
  valideFinanceAt   DateTime?
  valideTerrainById String?
  valideTerrainAt   DateTime?

  reverseeAt    DateTime @default(now())
  retardMinutes Int? // retard vs fin de shift (indicatif ; pénalité en paie, Partie D)

  detteId String? // dette créée si écart confirmé

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  depenses ReversementDepense[]

  @@index([siteId, date])
  @@index([driverId, date])
  @@index([statut])
}

// --- Dépense autorisée pendant le shift, déduite du montant à reverser ---
model ReversementDepense {
  id            String      @id @default(cuid())
  reversementId String
  reversement   Reversement @relation(fields: [reversementId], references: [id], onDelete: Cascade)
  montant       Int
  motif         String?
  preuveMediaId String?
  createdAt     DateTime    @default(now())

  @@index([reversementId])
}

// --- Dette chauffeur (créée sur écart de reversement confirmé) ; déduite en paie ---
model DetteChauffeur {
  id               String      @id @default(cuid())
  driverId         String
  siteId           String
  montant          Int
  montantRembourse Int         @default(0)
  motif            String?
  sourceType       String      @default("reversement")
  sourceId         String?
  statut           DetteStatut @default(EN_COURS)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([driverId])
  @@index([statut])
}

// =============================================================================
// SAVER Fleet Ops — Partie B (Bloc B3 : cas particulier — exception cash)
// =============================================================================

enum CompensationStatut {
  EN_ATTENTE_REGUL
  REGULARISE
}

// --- Exception cash : paiement en espèces exceptionnel déclaré par le Responsable terrain ---
model CompensationCash {
  id              String             @id @default(cuid())
  siteId          String
  driverId        String
  assignmentId    String?            @unique // rattachée à un shift précis (une seule exception par shift)
  date            DateTime?
  shift           ShiftCode?
  montant         Int
  motif           String
  declareParId    String?
  declareParNom   String?
  statut          CompensationStatut @default(EN_ATTENTE_REGUL)
  regulariseAt    DateTime?
  regulariseParId String?
  alerteJ1Envoyee Boolean            @default(false) // anti-doublon de l'alerte J+1 à Finance
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([siteId])
  @@index([driverId])
  @@index([statut])
}

// =============================================================================
// SAVER Fleet Ops — Partie C (Bloc C1 : Flux 3 — Recharge EV)
// =============================================================================

enum TypeCharge {
  DOMESTIQUE // réseau de bornes SAVER
  PARTENAIRE // opérateur partenaire (Arnio / Neo / Illigo)
}

// --- Borne de recharge whitelistée (réseau SAVER ou partenaire) ---
model BorneRecharge {
  id        String     @id @default(cuid())
  nom       String
  type      TypeCharge
  operateur String? // "SAVER" (domestique) ou "Arnio"/"Neo"/"Illigo" (partenaire)
  siteId    String? // rattachement site pour les bornes domestiques
  gpsLat    Float?
  gpsLng    Float?
  prixKwh   Int? // FCFA par kWh (sert à proposer le montant d'une recharge payée par le Superviseur)
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  @@index([type])
  @@index([active])
}

// --- Enregistrement d'une recharge d'un véhicule ---
model RechargeRecord {
  id              String     @id @default(cuid())
  vehicleId       String
  driverId        String? // chauffeur (null si saisie par l'équipe recharge le soir)
  enregistreParId String // utilisateur ayant saisi la recharge
  siteId          String
  date            DateTime   @default(now())
  shift           ShiftCode?

  typeCharge TypeCharge
  borneId    String? // borne whitelistée sélectionnée
  lieu       String? // libellé lieu / opérateur (saisie libre)

  kwh        Float? // quantité d'électricité (null si inconnue : recharge issue d'une demande)
  cout       Int // FCFA
  socDebut   Int // % batterie au début
  socFin     Int // % batterie à la fin
  kmAuMoment Int? // km du véhicule au moment (cohérence kWh ↔ km)

  justificatifMediaId String? // reçu / capture / photo de la borne

  anomalieCoherence Boolean @default(false) // kWh incohérents (SOC/km) → alerte Superviseur

  demandeId String? // recharge issue d'une demande payée par le Superviseur (une seule par demande, garanti par le code)

  createdAt DateTime @default(now())

  @@index([vehicleId, date])
  @@index([siteId, date])
  @@index([demandeId])
}

// =============================================================================
// Recharge payée par le Superviseur (2026-11) — demande + fil de discussion
// Le chauffeur demande, le Superviseur lui indique la borne, le chauffeur envoie
// les photos (QR code + tableau de bord), le Superviseur paie : l'argent ne passe
// jamais par le chauffeur.
// =============================================================================

enum DemandeRechargeStatut {
  DEMANDEE // le chauffeur vient de demander
  PRISE_EN_CHARGE // le Superviseur a indiqué la borne
  SUR_PLACE // photos QR + tableau de bord reçues : à payer
  PAYEE // le Superviseur a payé : le chauffeur peut brancher
  TERMINEE // photo du tableau de bord de fin reçue
  ANNULEE
}

model DemandeRecharge {
  id        String                @id @default(cuid())
  vehicleId String
  driverId  String
  siteId    String
  shift     ShiftCode?
  statut    DemandeRechargeStatut @default(DEMANDEE)

  borneId String? // borne indiquée par le Superviseur (liste autorisée)

  socDebut       Int? // % batterie lu sur le tableau de bord à l'arrivée
  socFin         Int? // % batterie à la fin
  socDebutIa     Int? // % lu par l'IA sur la photo d'arrivée (null si non lu)
  socFinIa       Int? // % lu par l'IA sur la photo de fin
  ecartIa        Boolean @default(false) // le chauffeur a saisi un % différent de celui lu par l'IA → contrôle
  // Véhicules sans % au tableau de bord (Eado) : jauge à barres + autonomie restante (socDebut/socFin = approximation d'après les barres)
  barresTotal      Int? // nombre de barres de la jauge
  barresDebut      Int? // barres pleines à l'arrivée
  barresFin        Int? // barres pleines à la fin
  autonomieDebutKm Int? // autonomie restante affichée à l'arrivée (km encore possibles, PAS le compteur total)
  autonomieFinKm   Int? // autonomie restante affichée à la fin
  kwhEstime      Float? // kWh nécessaires estimés (SOC × capacité)
  montantSuggere Int? // FCFA, si le prix du kWh de la borne est connu

  montantPaye    Int?
  refTransaction String?   @unique // n° de transaction du paiement (unique : anti-réutilisation)
  payeParId      String?
  payeLe         DateTime?

  termineLe       DateTime?
  annuleParId     String?
  motifAnnulation String?

  anomalie Boolean @default(false) // ex. batterie qui n'a pas monté

  preuvePaiementMediaId String? // capture de la confirmation Wave jointe par le Superviseur (invisible pour le chauffeur)
  ecartMontant          Boolean @default(false) // payé > montant proposé + 20 % → contrôle Finance
  anomaliePaiement      Boolean @default(false) // reçu Wave incohérent ou non vérifié par l'IA → contrôle Finance
  iaPaiement            Json? // lecture du reçu Wave par l'IA (montant, ID, date, marchand) + problèmes relevés

  // Contrôle par la Finance (séparation payeur / contrôleur)
  controleParId String?
  controleLe    DateTime?
  controleNote  String?

  messages DemandeRechargeMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, statut, createdAt])
  @@index([driverId, createdAt])
  @@index([vehicleId, statut])
}

// Création d'une borne ou modification (prix du kWh, coordonnées, réactivation…) proposée par
// le Superviseur : rien ne s'applique avant validation par l'Admin OU la Finance (pas l'auteur).
enum PropositionBorneStatut {
  EN_ATTENTE
  VALIDEE
  REFUSEE
}

model PropositionBorne {
  id           String                 @id @default(cuid())
  type         String // CREATION | MODIFICATION
  borneId      String? // borne concernée (MODIFICATION) ou créée (après validation d'une CREATION)
  siteId       String?
  donnees      Json // champs proposés
  avant        Json? // valeurs actuelles (MODIFICATION)
  statut       PropositionBorneStatut @default(EN_ATTENTE)
  proposeParId String
  traiteParId  String?
  traiteLe     DateTime?
  motifRefus   String?
  createdAt    DateTime               @default(now())

  @@index([statut, createdAt])
  @@index([borneId])
}

// Rapprochement GUIDÉ des paiements de recharge avec l'historique Wave de l'entreprise
// (pas d'export Wave disponible) : la Finance vérifie chaque paiement déclaré dans
// l'application Wave et saisit les paiements Wave sans demande. Séparation payeur / contrôleur.
enum RapprochementStatut {
  EN_COURS
  CLOTURE
}

enum VerdictRapprochement {
  CONFORME // vu dans Wave, même montant
  MONTANT_DIFFERENT // vu dans Wave, montant différent
  ABSENT // déclaré dans EASY mais introuvable dans Wave
  NON_DECLARE // vu dans Wave mais aucune demande dans EASY
}

model RapprochementWave {
  id           String               @id @default(cuid())
  debut        DateTime // inclus
  fin          DateTime // exclu (lendemain du dernier jour)
  statut       RapprochementStatut  @default(EN_COURS)
  creeParId    String
  clotureParId String?
  clotureLe    DateTime?
  resume       Json? // totaux et écarts figés à la clôture
  lignes       RapprochementLigne[]
  createdAt    DateTime             @default(now())

  @@index([statut, createdAt])
}

model RapprochementLigne {
  id              String                @id @default(cuid())
  rapprochementId String
  rapprochement   RapprochementWave     @relation(fields: [rapprochementId], references: [id], onDelete: Cascade)
  demandeId       String? // paiement déclaré (null = paiement Wave sans demande)
  verdict         VerdictRapprochement? // null = pas encore vérifié
  montantDeclare  Int? // copie du montant déclaré par le Superviseur
  montantReel     Int? // montant lu dans Wave (si différent, ou paiement non déclaré)
  refTransaction  String? // ID de transaction Wave (paiement non déclaré)
  dateTransaction DateTime? // date du paiement Wave (paiement non déclaré)
  marchand        String? // bénéficiaire lu dans Wave
  note            String?
  verifieParId    String?
  verifieLe       DateTime?
  createdAt       DateTime              @default(now())

  @@index([rapprochementId])
  @@index([demandeId])
}

model DemandeRechargeMessage {
  id        String          @id @default(cuid())
  demandeId String
  demande   DemandeRecharge @relation(fields: [demandeId], references: [id], onDelete: Cascade)
  auteurId  String? // null = message du système
  // TEXTE | SYSTEME | BORNE | PHOTOS_ARRIVEE | PAIEMENT | PHOTO_FIN | ANNULATION
  type      String
  texte     String?
  mediaIds  String[]        @default([])
  meta      Json?
  createdAt DateTime        @default(now())

  @@index([demandeId, createdAt])
}

// =============================================================================
// SAVER Fleet Ops — Partie C (Bloc C2 : Flux 4 — Panne & immobilisation)
// =============================================================================

enum PanneGravite {
  CRITIQUE // véhicule immobilisé
  NON_CRITIQUE
}

enum PanneStatut {
  DECLAREE // déclarée par le chauffeur, en attente de qualification
  QUALIFIEE // qualifiée par le Responsable terrain
  EN_REPARATION // prise en charge par la Maintenance (Bloc C2b)
  RESOLUE // réparée et véhicule réactivé (Bloc C2b)
  ANNULEE
}

// --- Déclaration de panne (Flux 4) ---
model Panne {
  id          String @id @default(cuid())
  vehicleId   String
  driverId    String // chauffeur déclarant
  siteId      String
  description String
  photos      Json   @default("[]") // ids des médias (preuves obligatoires)

  statut     PanneStatut   @default(DECLAREE)
  gravite    PanneGravite? // renseignée à la qualification
  immobilise Boolean       @default(false) // véhicule immobilisé suite à panne critique

  qualifieeById String?
  qualifieeAt   DateTime?

  declareeAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([siteId, statut])
  @@index([vehicleId])
  @@index([driverId])
}

// --- Garage partenaire (réparations) ---
model Garage {
  id        String   @id @default(cuid())
  nom       String
  ville     String?
  telephone String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([active])
}

enum ReparationStatut {
  PLANIFIE
  EN_COURS
  TERMINE
  ANNULE
}

enum StatutFacture {
  EN_ATTENTE
  PAYEE
}

// --- Prise en charge d'une réparation par la Maintenance (Bloc C2b) ---
model Reparation {
  id        String           @id @default(cuid())
  panneId   String
  vehicleId String
  siteId    String
  garageId  String
  statut    ReparationStatut @default(PLANIFIE)

  datePrevueDebut DateTime?
  datePrevueFin   DateTime?
  coutEstime      Int?

  devisMediaId   String? // devis (obligatoire au passage « en cours »)
  montantFacture Int? // renseigné à la clôture
  statutFacture  StatutFacture? // en attente / payée

  motifAnnulation String?

  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([panneId])
  @@index([siteId, statut])
  @@index([vehicleId])
}

// =============================================================================
// Appel intégré + notifications push (2026-11)
// =============================================================================

// Abonnement Web Push d'un appareil (un utilisateur peut en avoir plusieurs).
model PushAbonnement {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}
