# =============================================================================
# EV Premium Abidjan - variables d'environnement
# Copier ce fichier en `.env` puis renseigner les valeurs.
#   cp .env.example .env
# Le fichier `.env` est ignore par git : il ne doit JAMAIS etre commite.
# =============================================================================

# -----------------------------------------------------------------------------
# OBLIGATOIRE - Base de donnees PostgreSQL (lue par Prisma)
# Format : postgresql://UTILISATEUR:MOTDEPASSE@HOTE:PORT/BASE?schema=public
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/easy?schema=public"

# -----------------------------------------------------------------------------
# OBLIGATOIRE EN PRODUCTION - Secrets de signature des tokens JWT
# Sans ces valeurs, le serveur retombe sur des secrets en dur dans server.ts.
# Generer avec : openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# -----------------------------------------------------------------------------
# OPTIONNEL - Cartographie (selecteur d'adresse, suivi de course)
# -----------------------------------------------------------------------------
GOOGLE_MAPS_PLATFORM_KEY=

# -----------------------------------------------------------------------------
# OPTIONNEL - Envoi d'emails
# Brevo est essaye en premier ; a defaut, bascule sur le SMTP ci-dessous.
# Si rien n'est configure, les emails sont simplement ignores (log console).
# -----------------------------------------------------------------------------
BREVO_API_KEY=

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Adresse recevant les notifications administrateur.
# A defaut, SMTP_USER est utilise.
ADMIN_EMAIL=

# -----------------------------------------------------------------------------
# OPTIONNEL - Envoi de SMS via Twilio
# Si rien n'est configure, les SMS sont simplement ignores (log console).
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# -----------------------------------------------------------------------------
# DEVELOPPEMENT - mettre a "true" pour couper le HMR et le file watching de Vite
# -----------------------------------------------------------------------------
DISABLE_HMR=
